    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "@wxt-dev/module-react": "1.1.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
