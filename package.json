{
  "name": "apply-flow",
  "description": "Capture job listing details before adding them to a Google Sheets tracker.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
